# Copy to .env.local for local development. Never commit real credentials.
# These values are read by the Node server only. Do not prefix secrets with VITE_.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=smtp-account@example.com
SMTP_PASS=replace-with-a-real-secret

ENQUIRY_TO_EMAIL=enquiries@example.com
ENQUIRY_FROM_EMAIL=website@example.com

# Comma-separated exact origins. Set this explicitly in production.
ENQUIRY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Enable only behind a trusted reverse proxy that strips/replaces client forwarding headers.
TRUST_PROXY=false

HOST=127.0.0.1
PORT=5173
