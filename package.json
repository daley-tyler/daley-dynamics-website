{
  "name": "daley-dynamics-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env.local server/index.js --production",
    "start": "node server/index.js --production",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm test && npm run build && npm run check:site",
    "check:site": "node --test scripts/check-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource/michroma": "5.3.0",
    "nodemailer": "10.1.4"
  }
}
